+export function normalizeRulingText(text: string): string {
+  return text
+    .replaceAll("\u2019", "'")
+    .replaceAll("\u2018", "'")
+    .replaceAll("\u201c", '"')
+    .replaceAll("\u201d", '"')
+    .replaceAll("\u2014", "--")
+    .replaceAll("\u2013", "-")
+    .replaceAll("\u2026", "...")
+    .trim()
+    .split(/\s+/)
+    .join(" ");
 }
 
