 fn parse_ability_use_count_condition(lower: &str) -> Option<(AbilityUseTally, Comparator, u32)> {
-    let (rest, parsed) = alt((parse_nth_resolution_clause, parse_activation_count_clause))
-        .parse(lower)
-        .ok()?;
+    let (rest, parsed) = alt((
