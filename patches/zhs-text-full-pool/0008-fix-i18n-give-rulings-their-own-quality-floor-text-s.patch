From 1e38102b43d9da7b1a420370f153440f556d45ed Mon Sep 17 00:00:00 2001
From: haowen1993 <39072333+haowen1993@users.noreply.github.com>
Date: Wed, 7 Oct 2026 15:28:54 +0800
Subject: [PATCH 8/8] =?UTF-8?q?fix(i18n):=20give=20rulings=20their=20own?=
 =?UTF-8?q?=20quality=20floor=20=E2=80=94=20text's=20floor=20was=20starvin?=
 =?UTF-8?q?g=20them?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Card text and rulings need OPPOSITE floors, and sharing one cost 88% of the
rulings coverage.

A card's Oracle record is all-or-nothing: a low-tier record is an alternative to a
good one, so dropping stage 0 just leaves some cards English. Rulings are not
like that — a card has SEVERAL, so the floor drops some of them and leaves the
panel mixing Chinese and English sentences. Measured over the pool's 32,920
distinct rulings: stage 5+ covers 17,290 (52.5%), while including stage 0 covers
32,835 (99.7%). Inspected the stage-0 rows before deciding — they are machine
translations that keep the project's terminology consistent ("触发式异能",
"阻挡生物", "海岛"), and a readable Chinese sentence beats an English one inside a
Chinese card panel.

Per card: 19,572 of 20,052 cards with rulings are now fully Chinese (97%), 470
partially, 10 not at all. `--strict-ruling-stage` restores the old behaviour.

Also corrects a reporting error in the previous commit: it quoted "52,774
translations / 99%", which is the card×ruling count and is inflated by shared
boilerplate — one ruling appears on 105 cards. The honest metric is distinct
English rulings covered, which is what this message reports.
---
 scripts/gen-zhs-card-text.mjs | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/scripts/gen-zhs-card-text.mjs b/scripts/gen-zhs-card-text.mjs
index ec5ae7bcdb..51f68a890a 100644
--- a/scripts/gen-zhs-card-text.mjs
+++ b/scripts/gen-zhs-card-text.mjs
@@ -21,6 +21,7 @@
 //   node scripts/gen-zhs-card-text.mjs --release data-2026-10-04
 //   node scripts/gen-zhs-card-text.mjs --all-stages       # include stage 0
 //   node scripts/gen-zhs-card-text.mjs --skip-rulings     # text fields only
+//   node scripts/gen-zhs-card-text.mjs --strict-ruling-stage  # drop stage-0 rulings
 //   node scripts/gen-zhs-card-text.mjs --dry-run          # report, write nothing
 //
 // Output: client/public/card-data.zhs.json
@@ -64,6 +65,21 @@ const URL = `https://github.com/HeliumOctahelide/magic-cards-zhs/releases/downlo
 // field that day", so it is the default; `--all-stages` opts back in.
 const MIN_STAGE = allStages ? 0 : 5;
 
+/** Rulings keep their OWN floor, and it defaults to "everything".
+ *
+ * The card-text floor exists because a low-tier Oracle record is an alternative to
+ * a good one — you either read the card in Chinese or you do not. Rulings are not
+ * like that: a card has several, so a floor drops SOME of a card's rulings and
+ * leaves the panel mixing Chinese and English sentences. Measured over the pool,
+ * stage 5+ covers 17,290 of the engine's 32,920 distinct rulings (52.5%) while
+ * including stage 0 covers 32,835 (99.7%) — and the stage-0 rows are machine
+ * translations that keep the project's terminology consistent ("触发式异能",
+ * "阻挡生物", "海岛"). Given the choice between a readable Chinese sentence and an
+ * English one in a Chinese card panel, the Chinese one wins by default.
+ *
+ * `--text-stage-floor` / `--strict-ruling-stage` restore the filtered behaviour. */
+const MIN_RULING_STAGE = flag("strict-ruling-stage") ? MIN_STAGE : 0;
+
 /** Un-escape the dataset's one systematic malformation.
  *
  * 2,351 of 39,959 lines escape a literal double quote TWICE (`\\"`), which is
@@ -264,7 +280,7 @@ async function loadRulingTranslations() {
       stats.noTranslation += 1;
       continue;
     }
-    if ((record.stage ?? -1) < MIN_STAGE) {
+    if ((record.stage ?? -1) < MIN_RULING_STAGE) {
       stats.belowStage += 1;
       continue;
     }
@@ -273,7 +289,7 @@ async function loadRulingTranslations() {
   console.log(
     `rulings: ${translations.size} translations ` +
       `(${stats.lines} records, ${stats.malformed} malformed, ` +
-      `${stats.belowStage} below stage ${MIN_STAGE}, ${stats.noTranslation} untranslated)`,
+      `${stats.belowStage} below stage ${MIN_RULING_STAGE}, ${stats.noTranslation} untranslated)`,
   );
   return translations;
 }
