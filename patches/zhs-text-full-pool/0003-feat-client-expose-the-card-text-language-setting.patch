 client/src/i18n/locales/de/settings.json      |  6 ++--
 client/src/i18n/locales/en/settings.json      |  6 ++--
 client/src/i18n/locales/es/settings.json      |  6 ++--
 client/src/i18n/locales/fr/settings.json      |  6 ++--
